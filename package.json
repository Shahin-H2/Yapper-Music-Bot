{
  "name": "music-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Music bot for Yapin’ voice channels: local audio files and internet radio, with a Now Playing card and per-server queues",
  "type": "module",
  "main": "bot.js",
  "scripts": {
    "start": "node --env-file=.env bot.js",
    "dev": "node --env-file=.env --watch bot.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "yapin",
    "yapper",
    "bot",
    "music",
    "radio",
    "livekit",
    "ffmpeg"
  ],
  "author": "Shahin Hassanyan",
  "license": "UNLICENSED",
  "dependencies": {
    "@livekit/rtc-node": "^1.2.1"
  }
}
