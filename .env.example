# Copy this file to .env and put your token in it: cp .env.example .env
# `npm start` loads it with `node --env-file=.env` (Node 20.6+). Variables already set in your shell win over this
# file, except on Node 20.6.x, where this file wins.

# Required: your bot token (Yapin’ > Settings > Developer). It starts with yb_
YAPPER_BOT_TOKEN=yb_your_token_here

# ---- Optional settings (defaults shown) ----
# Folder with your audio files (.mp3 .wav .flac .ogg .opus .m4a), relative to the project root
# MUSIC_DIR=./music
# Radio presets
# STATIONS_FILE=./config/stations.json
# ffmpeg / ffprobe binaries, if they aren't on your PATH
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Volume a server starts at (1-200 %), and how much the 🔉/🔊 buttons change it (1-100)
# DEFAULT_VOLUME=100
# VOLUME_STEP=10
# Max tracks waiting in a server's queue (1-1000)
# MAX_QUEUE_SIZE=100
# Seconds to stay in voice after the queue ends / after everyone else left (0 = leave immediately)
# IDLE_TIMEOUT_SECONDS=30
# ALONE_TIMEOUT_SECONDS=30
# Allow /play <http(s) url> for streams that aren't presets (links into this computer's own network are always
# refused, but a public name can still point there: set false if you don't trust everyone who can use /play)
# ALLOW_URLS=true
# Only people in the bot's voice channel can use the playback commands and buttons
# REQUIRE_SAME_VOICE=true
# Embed accent colour (keep the quotes: an unquoted # starts a comment in .env files) and the bot's activity text
# EMBED_COLOR="#ff4fd8"
# BOT_STATUS=Listening to /play
# Audio buffered ahead in LiveKit, in ms: a multiple of 10 from 50 to 1000 (LiveKit crashes on other values, so
# the bot falls back to 200). Lower reacts faster to pause and volume; higher rides out network hiccups.
# AUDIO_QUEUE_MS=200
# Opus bitrate of the bot's voice track, in bits/s (32000-256000)
# AUDIO_BITRATE=128000
# debug | info | warn | error
# LOG_LEVEL=info
